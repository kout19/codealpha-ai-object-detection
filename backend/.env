# --- General app metadata ---
APP_NAME=AI Object Detection API
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# --- CORS: JSON array of allowed frontend origins ---
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- YOLO model settings ---
MODEL_PATH=yolov8n.pt
MODEL_CONFIDENCE_THRESHOLD=0.25
MODEL_DEVICE=cpu

# --- Upload constraints ---
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_UPLOAD_SIZE_MB=200
# --- Logging ---
LOG_LEVEL=INFO